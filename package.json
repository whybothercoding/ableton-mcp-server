{
  "name": "ableton-mcp-server",
  "version": "1.0.0",
  "description": "Stdio MCP server for Ableton Live via Remote Script TCP bridge",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ableton-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "python3 -m unittest discover -s test -p \"remote_script_test.py\" && npm run test:ts",
    "test:live": "node test/live-integration.mjs",
    "test:mcp": "node test/mcp-tools.mjs",
    "deploy": "node scripts/deploy.mjs",
    "hotswap": "node scripts/hotswap.mjs",
    "test:ts": "node --import tsx --test test/ts/*.test.ts",
    "dump-api": "node scripts/dump-api.mjs",
    "build-registry": "node scripts/build-registry.mjs",
    "test:drift": "node scripts/dump-api.mjs --check"
  },
  "keywords": [
    "mcp",
    "ableton",
    "ableton-live",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
